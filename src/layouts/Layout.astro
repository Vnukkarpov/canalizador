---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, any>;
  canonicalUrl?: string;
  noindex?: boolean;
}

const { 
  title, 
  description, 
  schema,
  canonicalUrl = Astro.url.href,
  noindex = false
} = Astro.props;

// LocalBusiness Schema for Karpov in Tavira
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "PlumbingService",
  "name": "Karpov — Canalizador em Tavira e Arredores",
  "image": "https://karpov.pt/og-image.jpg",
  "url": "https://karpov.pt",
  "telephone": "+351912224291",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Tavira",
    "addressRegion": "Faro / Algarve",
    "addressCountry": "PT"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 37.1261,
    "longitude": -7.6492
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "20:00"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Tavira" },
    { "@type": "City", "name": "Santa Luzia" },
    { "@type": "City", "name": "Cabanas de Tavira" },
    { "@type": "City", "name": "Conceição" },
    { "@type": "City", "name": "Luz de Tavira" },
    { "@type": "City", "name": "Olhão" },
    { "@type": "City", "name": "Faro" },
    { "@type": "City", "name": "Vila Real de Santo António" },
    { "@type": "City", "name": "Castro Marim" },
    { "@type": "City", "name": "São Brás de Alportel" }
  ]
};
---

<!doctype html>
<html lang="pt-PT" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans (Headings) & Inter (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_PT" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen">
    <slot />

    <!-- Sticky Mobile WhatsApp Button -->
    <div class="fixed bottom-4 left-4 right-4 md:hidden z-50">
      <a 
        href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20um%20canalizador%20em%20Tavira" 
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3.5 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base rounded-xl shadow-xl transition-all active:scale-[0.98]"
      >
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
        </span>
        WhatsApp: Falar com Canalizador
      </a>
    </div>
  </body>
</html>
