---
import { MapPin, Clock, ShieldCheck } from 'lucide-react';
import { getLocaleFromUrl, type Locale } from '../i18n/utils';

const locale: Locale = getLocaleFromUrl(Astro.url);

const t =
  locale === 'pt'
    ? {
        subtitle: 'Canalização',
        bio: 'Serviços profissionais de canalização em Tavira e no Sotavento Algarvio. Preços transparentes, pontualidade e fatura oficial com NIF.',
        location: 'Sede: Tavira, Algarve, Portugal',
        hours: 'Seg – Sáb: 08:00 – 20:00',
        insurance: 'Atividade e Seguro de Responsabilidade Civil',
        servicesTitle: 'Serviços & Preços',
        servicesAnchor: '/#servicos',
        services: [
          'Reparação de Autoclismo',
          'Torneiras & Misturadoras de Duche',
          'Substituição de Sanita Completa',
          'Móveis e Espelhos de Casa de Banho',
          'Montagem de Termoacumuladores',
          'Desentupimentos & Sifões',
          'Máquinas de Lavar & Filtros',
        ],
        areasTitle: 'Zonas Atendidas',
        areas: [
          'Tavira (Centro, Santa Maria, Santiago)',
          'Santa Luzia & Cabanas de Tavira',
          'Conceição & Luz de Tavira',
          'Santo Estêvão & Santa Catarina',
          'Olhão & Fuseta (~25 km)',
          'Faro & Montenegro (~38 km)',
          'Vila Real de Sto. António & Castro Marim',
          'São Brás de Alportel',
        ],
        quoteTitle: 'Pedir Orçamento',
        quoteDesc:
          'Envie-nos uma mensagem pelo WhatsApp com uma foto ou descrição da avaria para orçamento imediato.',
        whatsappHref:
          'https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20um%20orçamento',
        whatsappNote:
          'Orçamentos rápidos por WhatsApp: escreva em português ou inglês e envie uma foto.',
        rights: 'Karpov Canalizações. Todos os direitos reservados.',
        invoice: 'Fatura Legal com NIF',
        warranty: 'Garantia de Serviço',
        calculatorsLabel: 'Calculadoras',
        calculatorsHref: '/calculadoras/',
        blogLabel: 'Blog',
        blogHref: '/blog/',
      }
    : {
        subtitle: 'Plumbing',
        bio: 'Professional plumbing services in Tavira and the Eastern Algarve. Transparent pricing, punctuality, and official invoice with NIF.',
        location: 'Based in Tavira, Algarve, Portugal',
        hours: 'Mon – Sat: 08:00 – 20:00',
        insurance: 'Registered Business & Liability Insurance',
        servicesTitle: 'Services & Prices',
        servicesAnchor: '/en/#services',
        services: [
          'Toilet Cistern Repair',
          'Taps & Shower Mixers',
          'Full Toilet Replacement',
          'Bathroom Vanities & Mirrors',
          'Water Heater Installation',
          'Drain Unblocking & Traps',
          'Washing Machines & Filters',
        ],
        areasTitle: 'Service Areas',
        areas: [
          'Tavira (Centre, Santa Maria, Santiago)',
          'Santa Luzia & Cabanas de Tavira',
          'Conceição & Luz de Tavira',
          'Santo Estêvão & Santa Catarina',
          'Olhão & Fuseta (~25 km)',
          'Faro & Montenegro (~38 km)',
          'Vila Real de Sto. António & Castro Marim',
          'São Brás de Alportel',
        ],
        quoteTitle: 'Request a Quote',
        quoteDesc:
          'Send us a WhatsApp message with a photo or description of the issue for a fast estimate.',
        whatsappHref:
          'https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20a%20quote',
        whatsappNote:
          'Fast quotes via WhatsApp: write in English or Portuguese and attach a photo.',
        rights: 'Karpov Plumbing. All rights reserved.',
        invoice: 'Official Invoice with NIF',
        warranty: 'Service Warranty',
        calculatorsLabel: 'Calculators',
        calculatorsHref: '/en/calculators/',
        blogLabel: 'Blog',
        blogHref: '/en/blog/',
      };
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-24 md:pb-12 border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Col 1: Brand & Bio -->
      <div class="md:col-span-1">
        <div class="mb-4">
          <div class="brand-word font-display font-extrabold text-2xl tracking-tight text-slate-100 flex items-baseline" aria-label="Karpov.pt">
            <span aria-hidden="true">Karp</span><span class="text-blue-400" aria-hidden="true">o</span><span aria-hidden="true">v</span><span class="text-blue-400" aria-hidden="true">.</span><span aria-hidden="true">pt</span>
          </div>
          <p class="text-[11px] text-slate-400 font-medium tracking-wider uppercase">{t.subtitle}</p>
        </div>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          {t.bio}
        </p>
        <div class="text-xs text-slate-400 space-y-2">
          <p class="flex items-center gap-2">
            <MapPin className="w-3.5 h-3.5 text-blue-400 shrink-0" />
            <span>{t.location}</span>
          </p>
          <p class="flex items-center gap-2">
            <Clock className="w-3.5 h-3.5 text-blue-400 shrink-0" />
            <span>{t.hours}</span>
          </p>
          <p class="flex items-center gap-2">
            <ShieldCheck className="w-3.5 h-3.5 text-blue-400 shrink-0" />
            <span>{t.insurance}</span>
          </p>
        </div>
      </div>

      <!-- Col 2: Serviços Mais Pedidos -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-wide uppercase mb-4">{t.servicesTitle}</h4>
        <ul class="text-sm space-y-2.5 text-slate-400">
          {t.services.map((service) => (
            <li><a href={t.servicesAnchor} class="hover:text-white transition">{service}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Zonas de Cobertura -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-wide uppercase mb-4">{t.areasTitle}</h4>
        <ul class="text-sm space-y-2.5 text-slate-400">
          {t.areas.map((area) => (
            <li>{area}</li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contacto Direto -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-wide uppercase mb-4">{t.quoteTitle}</h4>
        <p class="text-sm text-slate-400 mb-4">
          {t.quoteDesc}
        </p>
        <a 
          href={t.whatsappHref} 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm transition"
        >
          WhatsApp: +351 912 22 42 91
        </a>
        <p class="text-xs text-slate-400 mt-3">
          {t.whatsappNote}
        </p>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-800 text-xs text-slate-400 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p>© {new Date().getFullYear()} {t.rights}</p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <span>{t.invoice}</span>
        <span>{t.warranty}</span>
        <a href={t.calculatorsHref} class="hover:text-slate-300 transition">{t.calculatorsLabel}</a>
        <a href={t.blogHref} class="hover:text-slate-300 transition">{t.blogLabel}</a>
      </div>
    </div>
  </div>
</footer>
