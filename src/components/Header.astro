---
import { getLocaleFromUrl, getLocalizedPath, type Locale } from '../i18n/utils';

const path = Astro.url.pathname;
const locale: Locale = getLocaleFromUrl(Astro.url);
const homeHref = locale === 'pt' ? '/' : '/en/';

const ptSwitchHref = getLocalizedPath(path, 'pt');
const enSwitchHref = getLocalizedPath(path, 'en');

const navItems =
  locale === 'pt'
    ? [
        { label: 'Serviços & Preços', href: '/#servicos' },
        { label: 'Zonas de Atuação', href: '/#zonas' },
        { label: 'Porquê Nós', href: '/#sobre' },
        { label: 'Calculadoras', href: '/calculadoras/', section: '/calculadoras' },
        { label: 'Blog', href: '/blog/', section: '/blog' },
        { label: 'FAQ', href: '/#faq' },
      ]
    : [
        { label: 'Services & Prices', href: '/en/#services' },
        { label: 'Service Areas', href: '/en/#areas' },
        { label: 'Why Us', href: '/en/#about' },
        { label: 'Calculators', href: '/en/calculators/', section: '/en/calculators' },
        { label: 'Blog', href: '/en/blog/', section: '/en/blog' },
        { label: 'FAQ', href: '/en/#faq' },
      ];

const isActive = (item: { section?: string }) =>
  !!item.section && path.startsWith(item.section);

const whatsappUrl =
  locale === 'pt'
    ? 'https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20um%20canalizador%20em%20Tavira'
    : 'https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20a%20plumber%20in%20Tavira';

const t =
  locale === 'pt'
    ? {
        homeAria: 'Karpov Canalização, página inicial',
        subtitle: 'Canalização',
        navAria: 'Navegação principal',
        mobileNavAria: 'Navegação móvel',
        whatsappCta: 'Orçamento via WhatsApp',
        menuOpen: 'Abrir menu',
        menuClose: 'Fechar menu',
        langAria: 'Mudar idioma',
      }
    : {
        homeAria: 'Karpov Plumbing, homepage',
        subtitle: 'Plumbing',
        navAria: 'Main navigation',
        mobileNavAria: 'Mobile navigation',
        whatsappCta: 'Quote via WhatsApp',
        menuOpen: 'Open menu',
        menuClose: 'Close menu',
        langAria: 'Switch language',
      };
---

<header id="site-header" class="sticky top-0 z-40 bg-white/85 backdrop-blur-xl border-b border-slate-200/80 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href={homeHref} class="group flex items-center gap-2.5 shrink-0" aria-label={t.homeAria}>
      <div>
        <div class="brand-word font-display font-extrabold text-2xl tracking-tight text-[#2d3440] flex items-baseline" aria-label="Karpov.pt">
          <span aria-hidden="true">Karp</span><span class="text-blue-600" aria-hidden="true">o</span><span aria-hidden="true">v.pt</span>
        </div>
        <p class="text-[10.5px] text-slate-500 font-semibold tracking-[0.14em] uppercase">{t.subtitle}</p>
      </div>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-slate-600" aria-label={t.navAria}>
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item) ? 'page' : undefined}
          class:list={[
            "relative py-1 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:rounded-full after:bg-gradient-to-r after:from-blue-600 after:to-sky-400 after:transition-all after:duration-300 hover:text-blue-600 hover:after:w-full",
            isActive(item) ? 'text-blue-600 after:w-full' : 'after:w-0',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Language switcher (real links for SEO) -->
      <nav aria-label={t.langAria} class="inline-flex items-center rounded-xl border border-slate-200 bg-slate-50 p-0.5 text-xs font-bold">
        <a
          href={ptSwitchHref}
          hreflang="pt-PT"
          lang="pt-PT"
          aria-current={locale === 'pt' ? 'page' : undefined}
          class:list={[
            'px-2.5 py-1.5 rounded-lg transition-colors',
            locale === 'pt'
              ? 'bg-white text-blue-600 shadow-xs'
              : 'text-slate-500 hover:text-slate-800',
          ]}
        >
          PT
        </a>
        <a
          href={enSwitchHref}
          hreflang="en"
          lang="en"
          aria-current={locale === 'en' ? 'page' : undefined}
          class:list={[
            'px-2.5 py-1.5 rounded-lg transition-colors',
            locale === 'en'
              ? 'bg-white text-blue-600 shadow-xs'
              : 'text-slate-500 hover:text-slate-800',
          ]}
        >
          EN
        </a>
      </nav>

      <!-- WhatsApp button (hidden on small screens: sticky button is at the bottom) -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm shadow-sm shadow-emerald-600/20 hover:shadow-md hover:shadow-emerald-600/25 hover:-translate-y-0.5 transition-all duration-200 active:scale-95 whitespace-nowrap"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-200 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
        </span>
        {t.whatsappCta}
      </a>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl border border-slate-200 bg-white text-slate-700 hover:text-blue-600 hover:border-blue-300 transition active:scale-95"
        aria-label={t.menuOpen}
        data-label-open={t.menuOpen}
        data-label-close={t.menuClose}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="icon-open w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="mobile-menu lg:hidden" hidden>
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 pb-6 pt-2 flex flex-col" aria-label={t.mobileNavAria}>
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item) ? 'page' : undefined}
          class:list={[
            'mobile-link flex items-center justify-between py-3.5 border-b border-slate-100 text-base font-semibold',
            isActive(item) ? 'text-blue-600' : 'text-slate-800',
          ]}
        >
          {item.label}
          <svg class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 6l6 6-6 6" />
          </svg>
        </a>
      ))}
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base shadow-sm transition active:scale-[0.98]"
      >
        {t.whatsappCta}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = toggle?.querySelector('.icon-open');
  const iconClose = toggle?.querySelector('.icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    const openLabel = toggle.getAttribute('data-label-open') ?? 'Abrir menu';
    const closeLabel = toggle.getAttribute('data-label-close') ?? 'Fechar menu';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    menu.hidden = !open;
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
