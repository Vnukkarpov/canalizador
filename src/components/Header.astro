---
---

<header class="sticky top-0 z-40 bg-white/85 backdrop-blur-xl border-b border-slate-200/80 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="group flex items-center gap-2.5">
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-display font-extrabold text-2xl tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">KARPOV</span>
          <!-- Subtle water droplet accent -->
          <svg class="w-3.5 h-3.5 text-blue-600 group-hover:text-sky-500 group-hover:-translate-y-0.5 transition-all duration-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
          </svg>
        </div>
        <p class="text-[10.5px] text-slate-500 font-semibold tracking-[0.14em] uppercase">Canalização</p>
      </div>
    </a>

    <!-- Navigation & Quick Contact -->
    <div class="flex items-center gap-5">
      <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-slate-600">
        <a href="#servicos" class="relative py-1 hover:text-blue-600 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-blue-600 after:to-sky-400 after:rounded-full after:transition-all after:duration-300">Serviços & Preços</a>
        <a href="#sobre" class="relative py-1 hover:text-blue-600 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-blue-600 after:to-sky-400 after:rounded-full after:transition-all after:duration-300">Porquê Nós</a>
        <a href="#zonas" class="relative py-1 hover:text-blue-600 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-blue-600 after:to-sky-400 after:rounded-full after:transition-all after:duration-300">Zonas de Atuação</a>
        <a href="#faq" class="relative py-1 hover:text-blue-600 transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 hover:after:w-full after:bg-gradient-to-r after:from-blue-600 after:to-sky-400 after:rounded-full after:transition-all after:duration-300">FAQ</a>
      </nav>

      <!-- Language Pill -->
      <div class="hidden lg:flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full bg-slate-100/90 text-slate-700 border border-slate-200/80">
        <span>🇵🇹 PT</span>
        <span class="text-slate-300">|</span>
        <span>🇬🇧 EN</span>
      </div>

      <!-- Action Button -->
      <a 
        href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20um%20canalizador%20em%20Tavira"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm shadow-sm shadow-emerald-600/20 hover:shadow-md hover:shadow-emerald-600/25 hover:-translate-y-0.5 transition-all duration-200 active:scale-95 whitespace-nowrap"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-200 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
        </span>
        Orçamento via WhatsApp
      </a>
    </div>
  </div>
</header>
