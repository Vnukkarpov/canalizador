---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { 
  Toilet, 
  Droplets,
  ShowerHead, 
  Bath,
  Columns2,
  Lightbulb,
  Flame, 
  Waves, 
  WashingMachine, 
  ShieldCheck, 
  Clock, 
  Receipt, 
  Sparkles, 
  FileText, 
  Wrench, 
  Languages, 
  MapPin, 
  Check 
} from 'lucide-react';

const pageTitle = "Canalizador em Tavira | Reparações Rápidas & Preços Claros | Karpov";
const pageDescription = "Precisa de um canalizador em Tavira ou arredores? Reparação de autoclismos, torneiras, termoacumuladores e desentupimentos. Pontualidade, preços fechados e fatura com NIF.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto cobram pela deslocação em Tavira?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para intervenções realizadas no concelho de Tavira, a deslocação está incluída no orçamento global acordado antes do trabalho. Em caso de visita apenas para diagnóstico sem execução do serviço, a taxa é de 25€."
      }
    },
    {
      "@type": "Question",
      "name": "Passam fatura com NIF para o IRS?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, todas as intervenções têm emissão de fatura-recibo legal comunicada à Autoridade Tributária com o seu NIF, o que permite dedução de despesas no IRS e confere garantia por escrito."
      }
    },
    {
      "@type": "Question",
      "name": "Falam inglês com os clientes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, prestamos atendimento fluente em Português e Inglês (We speak fluent English), facilitando a comunicação com a comunidade residente e estrangeira em Tavira e no Algarve."
      }
    },
    {
      "@type": "Question",
      "name": "Com que rapidez conseguem atender um pedido?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para serviços normais e reparações comuns, agendamos com hora marcada habitualmente no próprio dia ou no dia útil seguinte."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} schema={faqSchema}>
  <Header />

  <main class="flex-grow">
    <!-- HERO SECTION -->
    <section class="relative bg-gradient-to-b from-blue-50/60 via-white to-slate-50 pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="max-w-3xl">
          <!-- Local Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 text-blue-800 text-xs sm:text-sm font-semibold mb-6 border border-blue-200">
            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
            Tavira e em toda a zona de Faro a Vila Real de Santo António
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight mb-6">
            Canalizador em Tavira: <br class="hidden sm:inline" />
            <span class="text-blue-600">Reparações Rápidas</span>, Preços Transparentes e Pontualidade.
          </h1>

          <!-- Subtitle -->
          <p class="text-lg sm:text-xl text-slate-600 mb-8 leading-relaxed">
            Autoclismo a correr água, torneira a pingar ou termoacumulador sem água quente? 
            A <strong>Karpov</strong> resolve as avarias mais comuns da sua casa com preço fechado antes de começar, trabalho limpo e fatura oficial com NIF.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-10">
            <a 
              href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20um%20orçamento%20em%20Tavira" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-base shadow-lg shadow-emerald-600/20 transition active:scale-[0.98]"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z"/>
              </svg>
              Pedir Orçamento via WhatsApp
            </a>

            <a 
              href="#servicos" 
              class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-bold text-base border border-slate-300 shadow-sm transition"
            >
              Ver Serviços e Preços ↓
            </a>
