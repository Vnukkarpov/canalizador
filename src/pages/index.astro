---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { 
  Toilet, 
  ShowerHead, 
  Flame, 
  Waves, 
  WashingMachine, 
  ShieldCheck, 
  Clock, 
  Receipt, 
  Sparkles, 
  FileText, 
  Wrench, 
  Languages, 
  MapPin, 
  Check 
} from 'lucide-react';

const pageTitle = "Canalizador em Tavira | Reparações Rápidas & Preços Claros | Karpov";
const pageDescription = "Precisa de um canalizador em Tavira ou arredores? Reparação de autoclismos, torneiras, termoacumuladores e desentupimentos. Pontualidade, preços fechados e fatura com NIF.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto cobram pela deslocação em Tavira?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para intervenções realizadas no concelho de Tavira, a deslocação está incluída no orçamento global acordado antes do trabalho. Em caso de visita apenas para diagnóstico sem execução do serviço, a taxa é de 25€."
      }
    },
    {
      "@type": "Question",
      "name": "Passam fatura com NIF para o IRS?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, todas as intervenções têm emissão de fatura-recibo legal comunicada à Autoridade Tributária com o seu NIF, o que permite dedução de despesas no IRS e confere garantia por escrito."
      }
    },
    {
      "@type": "Question",
      "name": "Falam inglês com os clientes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, prestamos atendimento fluente em Português e Inglês (We speak fluent English), facilitando a comunicação com a comunidade residente e estrangeira em Tavira e no Algarve."
      }
    },
    {
      "@type": "Question",
      "name": "Com que rapidez conseguem atender um pedido?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para serviços normais e reparações comuns, agendamos com hora marcada habitualmente no próprio dia ou no dia útil seguinte."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} schema={faqSchema}>
  <Header />

  <main class="flex-grow">
    <!-- HERO SECTION -->
    <section class="relative bg-gradient-to-b from-blue-50/60 via-white to-slate-50 pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="max-w-3xl">
          <!-- Local Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 text-blue-800 text-xs sm:text-sm font-semibold mb-6 border border-blue-200">
            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
            Tavira e em toda a zona de Faro a Vila Real de Santo António
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight mb-6">
            Canalizador em Tavira: <br class="hidden sm:inline" />
            <span class="text-blue-600">Reparações Rápidas</span>, Preços Transparentes e Pontualidade.
          </h1>

          <!-- Subtitle -->
          <p class="text-lg sm:text-xl text-slate-600 mb-8 leading-relaxed">
            Autoclismo a correr água, torneira a pingar ou termoacumulador sem água quente? 
            A <strong>Karpov</strong> resolve as avarias mais comuns da sua casa com preço fechado antes de começar, trabalho limpo e fatura oficial com NIF.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-10">
            <a 
              href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20um%20orçamento%20em%20Tavira" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-base shadow-lg shadow-emerald-600/20 transition active:scale-[0.98]"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z"/>
              </svg>
              Pedir Orçamento via WhatsApp
            </a>

            <a 
              href="#precos" 
              class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-bold text-base border border-slate-300 shadow-sm transition"
            >
              Ver Tabela de Preços ↓
            </a>
          </div>

          <!-- Trust Checkmarks -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-slate-200/80 text-xs sm:text-sm font-semibold text-slate-700">
            <div class="flex items-center gap-2">
              <Check className="w-4 h-4 text-blue-600 stroke-[2.5]" />
              <span>Preço Fechado</span>
            </div>
            <div class="flex items-center gap-2">
              <Check className="w-4 h-4 text-blue-600 stroke-[2.5]" />
              <span>Pontualidade Real</span>
            </div>
            <div class="flex items-center gap-2">
              <Check className="w-4 h-4 text-blue-600 stroke-[2.5]" />
              <span>Fatura com NIF</span>
            </div>
            <div class="flex items-center gap-2">
              <Check className="w-4 h-4 text-blue-600 stroke-[2.5]" />
              <span>Falamos PT & EN</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AVARIAS COMUNS (CLICK-TO-WHATSAPP) -->
    <section id="avarias" class="py-16 bg-white border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Apoio Rápido</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2">Qual é a avaria em sua casa hoje?</h2>
          <p class="text-slate-600 mt-3 text-sm sm:text-base">
            Clique no seu problema para abrir diretamente uma conversa no WhatsApp com orçamento estimado e disponibilidade:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- Card 1: Autoclismo -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20o%20meu%20autoclismo%20está%20a%20correr%20água/avariado%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 rounded-2xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200 hover:border-blue-300 transition-all shadow-sm hover:shadow-md flex flex-col justify-between"
          >
            <div>
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition duration-200">
                <Toilet className="w-5 h-5 stroke-[1.8]" />
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition">Autoclismo a Correr Água</h3>
              <p class="text-slate-600 text-sm mt-2 leading-relaxed">
                Água a correr continuamente na sanita, boia que não fecha ou autoclismo que não enche.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold text-blue-600">
              <span>A partir de 45€</span>
              <span class="group-hover:translate-x-1 transition">Pedir Reparação →</span>
            </div>
          </a>

          <!-- Card 2: Torneira -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20reparar/trocar%20uma%20torneira%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 rounded-2xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200 hover:border-blue-300 transition-all shadow-sm hover:shadow-md flex flex-col justify-between"
          >
            <div>
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition duration-200">
                <ShowerHead className="w-5 h-5 stroke-[1.8]" />
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition">Torneira a Pingar ou Nova</h3>
              <p class="text-slate-600 text-sm mt-2 leading-relaxed">
                Substituição de torneira de cozinha ou casa de banho, troca de cartucho e bichas flexíveis.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold text-blue-600">
              <span>A partir de 40€</span>
              <span class="group-hover:translate-x-1 transition">Pedir Reparação →</span>
            </div>
          </a>

          <!-- Card 3: Termoacumulador -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20o%20meu%20termoacumulador%20não%20aquece/está%20a%20verter%20água"
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 rounded-2xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200 hover:border-blue-300 transition-all shadow-sm hover:shadow-md flex flex-col justify-between"
          >
            <div>
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition duration-200">
                <Flame className="w-5 h-5 stroke-[1.8]" />
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition">Termoacumulador (Cilindro)</h3>
              <p class="text-slate-600 text-sm mt-2 leading-relaxed">
                Sem água quente, água morna devido ao calcário, fuga na válvula de segurança ou montagem de novo.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold text-blue-600">
              <span>A partir de 95€</span>
              <span class="group-hover:translate-x-1 transition">Pedir Assistência →</span>
            </div>
          </a>

          <!-- Card 4: Desentupimento simples -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20tenho%20um%20cano/ralo/lava-loiça%20entupido%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 rounded-2xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200 hover:border-blue-300 transition-all shadow-sm hover:shadow-md flex flex-col justify-between"
          >
            <div>
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition duration-200">
                <Waves className="w-5 h-5 stroke-[1.8]" />
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition">Sifão e Lava-Loiça Entupido</h3>
              <p class="text-slate-600 text-sm mt-2 leading-relaxed">
                Água que não escoa na pia ou base de duche, maus cheiros na canalização e limpeza mecânica de sifões.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold text-blue-600">
              <span>A partir de 50€</span>
              <span class="group-hover:translate-x-1 transition">Desentupir Agora →</span>
            </div>
          </a>

          <!-- Card 5: Máquinas de lavar -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20ligar%20uma%20máquina%20de%20lavar%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 rounded-2xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200 hover:border-blue-300 transition-all shadow-sm hover:shadow-md flex flex-col justify-between"
          >
            <div>
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition duration-200">
                <WashingMachine className="w-5 h-5 stroke-[1.8]" />
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition">Ligação de Eletrodomésticos</h3>
              <p class="text-slate-600 text-sm mt-2 leading-relaxed">
                Instalação hidráulica segura de máquinas de lavar roupa ou loiça com torneira de segurança e esgoto.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold text-blue-600">
              <span>A partir de 35€</span>
              <span class="group-hover:translate-x-1 transition">Agendar Instalação →</span>
            </div>
          </a>

          <!-- Card 6: Filtros Calcário -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20quero%20instalar%20um%20filtro%20anticalcário%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="group p-6 rounded-2xl bg-slate-50 hover:bg-blue-50/50 border border-slate-200 hover:border-blue-300 transition-all shadow-sm hover:shadow-md flex flex-col justify-between"
          >
            <div>
              <div class="w-11 h-11 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-105 group-hover:bg-blue-600 group-hover:text-white transition duration-200">
                <ShieldCheck className="w-5 h-5 stroke-[1.8]" />
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition">Filtro Anticalcário (Água Dura)</h3>
              <p class="text-slate-600 text-sm mt-2 leading-relaxed">
                Instalação de filtro de polifosfatos para proteger o termoacumulador da água dura do Algarve.
              </p>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold text-blue-600">
              <span>A partir de 65€</span>
              <span class="group-hover:translate-x-1 transition">Proteger Aparelhos →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- PREÇOS TRANSPARENTES -->
    <section id="precos" class="py-16 bg-slate-50 border-b border-slate-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Transparência Total</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2">Preços de Referência Sem Surpresas</h2>
          <p class="text-slate-600 mt-3 text-sm sm:text-base">
            O valor que combinamos antes de começar é exatamente o valor que paga. Sem taxas escondidas no final.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="divide-y divide-slate-100">
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50/60 transition">
              <div>
                <h4 class="font-bold text-slate-900 text-base">Reparação de Autoclismo (Sanita)</h4>
                <p class="text-xs sm:text-sm text-slate-500">Mecanismo de descarga, substituição de boia ou vedante de borracha</p>
              </div>
              <div class="text-left sm:text-right">
                <span class="font-extrabold text-blue-600 text-lg">A partir de 45€</span>
                <p class="text-[11px] text-slate-400">~45–60 min</p>
              </div>
            </div>

            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50/60 transition">
              <div>
                <h4 class="font-bold text-slate-900 text-base">Substituição de Torneira ou Misturadora</h4>
                <p class="text-xs sm:text-sm text-slate-500">Lava-loiça, lavatório ou base de duche, com bichas flexíveis novas</p>
              </div>
              <div class="text-left sm:text-right">
                <span class="font-extrabold text-blue-600 text-lg">A partir de 40€</span>
                <p class="text-[11px] text-slate-400">~45 min</p>
              </div>
            </div>

            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50/60 transition">
              <div>
                <h4 class="font-bold text-slate-900 text-base">Montagem de Termoacumulador Elétrico</h4>
                <p class="text-xs sm:text-sm text-slate-500">Desmontagem do antigo, fixação reforçada, ligação hidráulica e teste</p>
              </div>
              <div class="text-left sm:text-right">
                <span class="font-extrabold text-blue-600 text-lg">A partir de 95€</span>
                <p class="text-[11px] text-slate-400">~1h30 – 2h</p>
              </div>
            </div>

            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50/60 transition">
              <div>
                <h4 class="font-bold text-slate-900 text-base">Desentupimento Simples de Sifão / Ralo</h4>
                <p class="text-xs sm:text-sm text-slate-500">Desobstrução e higienização mecânica de lava-loiças, lavatórios ou duches</p>
              </div>
              <div class="text-left sm:text-right">
                <span class="font-extrabold text-blue-600 text-lg">A partir de 50€</span>
                <p class="text-[11px] text-slate-400">~45 min</p>
              </div>
            </div>

            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-slate-50/60 transition">
              <div>
                <h4 class="font-bold text-slate-900 text-base">Instalação de Filtro Anticalcário</h4>
                <p class="text-xs sm:text-sm text-slate-500">Proteção de polifosfatos para cilindro ou entrada de eletrodomésticos</p>
              </div>
              <div class="text-left sm:text-right">
                <span class="font-extrabold text-blue-600 text-lg">A partir de 65€</span>
                <p class="text-[11px] text-slate-400">~1 hora</p>
              </div>
            </div>
          </div>
          <div class="p-4 bg-slate-100/70 border-t border-slate-200 text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-2">
            <span>Valores de mão de obra de referência. Materiais faturados à parte com comprovativo.</span>
            <span class="font-semibold text-slate-700">Fatura oficial com NIF incluída</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PORQUÊ NÓS (DIFERENCIAIS) -->
    <section id="sobre" class="py-16 bg-white border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Compromisso Karpov</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-2">Por que confiar na nossa equipa?</h2>
          <p class="text-slate-600 mt-3 text-sm sm:text-base">
            Sabemos que chamar um técnico a casa muitas vezes gera desconfiança. Eliminámos todos os problemas habituais:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-blue-600 shadow-xs flex items-center justify-center mb-4">
              <Clock className="w-5 h-5 stroke-[1.8]" />
            </div>
            <h3 class="font-bold text-lg text-slate-900">Pontualidade Rigorosa</h3>
            <p class="text-slate-600 text-sm mt-2 leading-relaxed">
              Respeitamos o seu tempo. Se marcamos para as 10:00, estamos lá às 10:00. Se houver trânsito inesperado, enviamos mensagem 30 minutos antes.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-blue-600 shadow-xs flex items-center justify-center mb-4">
              <Receipt className="w-5 h-5 stroke-[1.8]" />
            </div>
            <h3 class="font-bold text-lg text-slate-900">Zero Surpresas na Conta</h3>
            <p class="text-slate-600 text-sm mt-2 leading-relaxed">
              Diagnosticamos o problema, explicamos as opções e confirmamos o valor exato consigo antes de pegar em qualquer ferramenta.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-blue-600 shadow-xs flex items-center justify-center mb-4">
              <Sparkles className="w-5 h-5 stroke-[1.8]" />
            </div>
            <h3 class="font-bold text-lg text-slate-900">Trabalho Limpo e Cuidado</h3>
            <p class="text-slate-600 text-sm mt-2 leading-relaxed">
              Usamos proteções para calçado, panos de proteção e deixamos o espaço impecavelmente limpo, levando as peças velhas para reciclagem.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-blue-600 shadow-xs flex items-center justify-center mb-4">
