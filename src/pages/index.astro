---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { 
  Toilet, 
  Droplets,
  ShowerHead, 
  Bath,
  Columns2,
  Lightbulb,
  Flame, 
  Waves, 
  WashingMachine, 
  ShieldCheck, 
  Clock, 
  Receipt, 
  Sparkles, 
  FileText, 
  Wrench, 
  Languages, 
  MapPin, 
  Check 
} from 'lucide-react';

const pageTitle = "Canalizador em Tavira | Reparações Rápidas & Preços Claros | Karpov";
const pageDescription = "Precisa de um canalizador em Tavira ou arredores? Reparação de autoclismos, torneiras, sanitas, móveis de WC, termoacumuladores e desentupimentos. Preços fechados e fatura com NIF.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quanto cobram pela deslocação em Tavira?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para intervenções realizadas no concelho de Tavira, a deslocação está incluída no orçamento global acordado antes do trabalho. Em caso de visita apenas para diagnóstico sem execução do serviço, a taxa é de 25€."
      }
    },
    {
      "@type": "Question",
      "name": "Passam fatura com NIF para o IRS?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, todas as intervenções têm emissão de fatura-recibo legal comunicada à Autoridade Tributária com o seu NIF, o que permite dedução de despesas no IRS e confere garantia por escrito."
      }
    },
    {
      "@type": "Question",
      "name": "Posso escrever em inglês?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim, pode escrever em português ou inglês (You are welcome to write in English). Não somos fluentes em inglês, mas esforçamo-nos por perceber bem cada pedido e recomendamos enviar uma foto ou mensagem escrita pelo WhatsApp para evitar mal-entendidos."
      }
    },
    {
      "@type": "Question",
      "name": "Com que rapidez conseguem atender um pedido?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para serviços normais e reparações comuns, agendamos com hora marcada habitualmente no próprio dia ou no dia útil seguinte."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} schema={faqSchema}>
  <Header />

  <main class="flex-grow">
    <!-- HERO SECTION -->
    <section class="relative overflow-hidden bg-gradient-to-b from-sky-50/70 via-blue-50/30 to-white pt-14 pb-24 md:pt-24 md:pb-32">
      <!-- Subtle Ambient Water Glow Orbs -->
      <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 rounded-full bg-sky-200/35 blur-3xl"></div>
      <div class="pointer-events-none absolute top-1/2 -left-24 w-80 h-80 rounded-full bg-blue-200/25 blur-3xl"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
        <div class="max-w-3xl">
          <!-- Local Badge with Water Ripple Pulse -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/90 backdrop-blur-xs text-blue-800 text-xs sm:text-sm font-semibold mb-7 border border-blue-200/80 shadow-2xs">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-blue-600"></span>
            </span>
            Tavira e em toda a zona de Faro a Vila Real de Santo António
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-5xl lg:text-[3.4rem] font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-6">
            Canalizador em Tavira: <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-blue-600 via-blue-700 to-sky-500 bg-clip-text text-transparent">Reparações Rápidas</span>, Preços Transparentes e Pontualidade.
          </h1>

          <!-- Subtitle -->
          <p class="text-lg sm:text-xl text-slate-600 mb-9 leading-relaxed max-w-2xl">
            Autoclismo a correr água, torneira a pingar, substituição de sanita ou termoacumulador? 
            A <strong class="text-slate-800 font-semibold">Karpov</strong> resolve as avarias e instalações da sua casa com preço fechado antes de começar, trabalho limpo e fatura oficial com NIF.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-12">
            <a 
              href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20um%20orçamento%20em%20Tavira" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base shadow-lg shadow-emerald-600/20 hover:shadow-xl hover:shadow-emerald-600/25 hover:-translate-y-0.5 transition-all duration-200 active:scale-[0.98]"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z"/>
              </svg>
              Pedir Orçamento via WhatsApp
            </a>

            <a 
              href="#servicos" 
              class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white hover:bg-blue-50/40 text-slate-800 hover:text-blue-700 font-bold text-base border border-slate-300 hover:border-blue-300 shadow-xs hover:-translate-y-0.5 transition-all duration-200"
            >
              Ver Serviços e Preços ↓
            </a>
          </div>

          <!-- Trust Checkmarks (Glass Pills) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs sm:text-sm font-semibold text-slate-700">
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>Preço Fechado</span>
            </div>
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>Pontualidade Real</span>
            </div>
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>Fatura com NIF</span>
            </div>
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>Escreva em PT ou EN</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Subtle Water Wave Divider -->
      <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none pointer-events-none">
        <svg class="relative block w-full h-8 sm:h-12 text-white" viewBox="0 0 1440 72" fill="none" preserveAspectRatio="none">
          <path d="M0,32 C320,76 640,-8 960,32 C1200,62 1360,24 1440,12 L1440,72 L0,72 Z" fill="rgba(224, 242, 254, 0.5)" />
          <path d="M0,48 C360,8 720,72 1080,32 C1260,12 1380,28 1440,40 L1440,72 L0,72 Z" fill="currentColor" />
        </svg>
      </div>
    </section>

    <!-- SERVIÇOS & PREÇOS TRANSPARENTES (CLICK-TO-WHATSAPP) -->
    <section id="servicos" class="py-20 md:py-26 bg-white border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="inline-flex items-center gap-1.5 text-blue-600 font-bold text-xs uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
            Serviços & Preços Claros
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-3">Do que precisa em sua casa hoje?</h2>
          <p class="text-slate-600 mt-3.5 text-sm sm:text-base leading-relaxed">
            Preços de referência transparentes e sem surpresas. Clique no serviço desejado para abrir diretamente o WhatsApp com orçamento e disponibilidade:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card 1: Autoclismo -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20o%20meu%20autoclismo%20está%20a%20correr%20água/avariado%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Toilet className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~45–60 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Reparação de Autoclismo</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Água a correr continuamente na sanita, boia que não fecha, botão de descarga avariado ou autoclismo que não enche.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Mão de obra</span>
                <span class="font-display font-extrabold text-base text-blue-600">A partir de 45€</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Pedir no WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 2: Torneira Cozinha / Lavatório -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20reparar/trocar%20uma%20torneira%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Droplets className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~45 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Torneira a Pingar ou Nova</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Substituição de torneira de lava-loiça, lavatório ou bidé, troca de cartucho cerâmico e bichas flexíveis novas.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Mão de obra</span>
                <span class="font-display font-extrabold text-base text-blue-600">A partir de 40€</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Pedir no WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 3: Misturadora de Duche / Banheira -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20substituir%20uma%20misturadora%20de%20duche/banheira%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <ShowerHead className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~45–60 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Misturadora de Duche / Banheira</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Troca de torneira misturadora ou termostática de duche, instalação de coluna de duche, rampa, bicha e chuveiro.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Mão de obra</span>
                <span class="font-display font-extrabold text-base text-blue-600">A partir de 45€</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Pedir no WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 4: Substituição de Sanita -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20substituir/instalar%20uma%20sanita%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Bath className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~1h30</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Substituição de Sanita Completa</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Desmontagem da sanita antiga, instalação de sanita nova com autoclismo e tampo, ligação ao esgoto e vedação em silicone.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Mão de obra</span>
                <span class="font-display font-extrabold text-base text-blue-600">A partir de 75€</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Pedir no WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 5: Instalação de Móvel de Casa de Banho (Lavatório) -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20instalar%20um%20móvel%20de%20casa%20de%20banho%20com%20lavatório%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Columns2 className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~1h30 – 2h</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Móvel de Casa de Banho (Lavatório)</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Montagem e fixação de móvel suspenso ou de pousar, instalação do lavatório, torneira, válvula de escoamento e sifão.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Mão de obra</span>
                <span class="font-display font-extrabold text-base text-blue-600">A partir de 75€</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Pedir no WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 6: Instalação de Espelho de Casa de Banho -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20preciso%20de%20instalar%20um%20espelho%20de%20casa%20de%20banho%20em%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Lightbulb className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~30–45 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Espelho ou Armário de WC</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Furação limpa em azulejo sem partir, fixação nivelada de espelho simples, armário de parede ou espelho com iluminação LED.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Mão de obra</span>
                <span class="font-display font-extrabold text-base text-blue-600">A partir de 35€</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Pedir no WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 7: Termoacumulador -->
          <a 
            href="https://wa.me/351912224291?text=Olá%20Karpov,%20o%20meu%20termoacumulador%20não%20aquece/está%20a%20verter%20água"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
