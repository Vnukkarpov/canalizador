---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CalculadoraRemodelacao from '../../components/CalculadoraRemodelacao';

const title = 'Calculadora: Preço de Canalização para T1, T2 e T3 | Karpov';
const description =
  'Calcule o preço estimado da canalização do seu apartamento ou moradia (T1, T2, T3) em PEX ou multicamada. Escolha pontos de água, complexidade e extras.';

const wa =
  'https://wa.me/351912224291?text=Olá%20Karpov,%20gostaria%20de%20pedir%20um%20cálculo%20de%20canalização';

const steps = [
  ['Escolha o imóvel', 'Apartamento ou moradia e a tipologia (T1, T2 ou T3).'],
  ['Escolha o material', 'PEX (mais económico) ou multicamada.'],
  ['Indique o tipo de trabalho', 'Instalação nova ou renovação, e o grau de dificuldade de acesso.'],
  ['Marque os pontos de água', 'Sanitas, lavatórios, duches, cozinha, máquinas de lavar roupa e loiça, lavandaria.'],
  ['Veja a estimativa', 'O valor atualiza-se sozinho. Pode enviá-lo para o WhatsApp com um clique.'],
];
---

<Layout title={title} description={description}>
  <Header />

  <main class="flex-grow">
    <section class="bg-gradient-to-b from-sky-50/70 via-blue-50/30 to-white pt-12 pb-8 md:pt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <nav class="text-sm text-slate-500 mb-6">
          <a href="/" class="hover:text-blue-600">Início</a> /
          <a href="/calculadoras/" class="hover:text-blue-600">Calculadoras</a>
        </nav>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight">
          Calculadora de canalização para T1, T2 e T3
        </h1>
        <p class="text-slate-600 mt-3 text-lg max-w-2xl">
          Descubra em poucos cliques quanto pode custar a canalização do seu apartamento ou moradia.
        </p>

        <div class="mt-8 rounded-2xl bg-white border border-slate-200 p-5 sm:p-6">
          <h2 class="text-xl font-bold text-slate-900">Como usar a calculadora</h2>
          <ol class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {steps.map(([t, d], i) => (
              <li class="flex gap-3">
                <span class="shrink-0 w-7 h-7 rounded-full bg-blue-50 border border-blue-100 text-blue-700 font-bold text-sm flex items-center justify-center">{i + 1}</span>
                <span class="text-sm text-slate-600"><strong class="block text-slate-900">{t}</strong>{d}</span>
              </li>
            ))}
          </ol>
          <p class="text-sm text-slate-500 mt-4">
            Dica: some os pontos de <strong>todas</strong> as casas de banho e lavabos. Se tiver dúvidas sobre
            algum campo, escolha o valor mais próximo — acertamos tudo no orçamento final.
          </p>
        </div>
      </div>
    </section>

    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-12">
      <CalculadoraRemodelacao client:load />

      <div class="mt-8 p-5 rounded-2xl bg-amber-50 border border-amber-200 text-sm text-slate-700 leading-relaxed">
        <strong>Importante:</strong> os valores apresentados são <strong>preços estimados (de referência)</strong> e
        <strong>não constituem uma oferta ou proposta vinculativa</strong>. O preço final depende da visita
        ao local, do estado da instalação e dos materiais escolhidos. Para pedir um cálculo exato, contacte-nos
        pelo WhatsApp.
      </div>

      <div class="mt-6 text-center">
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold shadow-sm transition"
        >
          Pedir cálculo exato no WhatsApp
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
