---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  Toilet,
  Droplets,
  ShowerHead,
  Columns2,
  Lightbulb,
  Flame,
  Waves,
  WashingMachine,
  ShieldCheck,
  Clock,
  Receipt,
  Sparkles,
  FileText,
  Wrench,
  Languages,
  MapPin,
  Check,
  Calculator,
} from 'lucide-react';

const pageTitle = 'Plumber in Tavira & Algarve | Fast Repairs & Clear Prices | Karpov';
const pageDescription =
  'Need a plumber in Tavira or the Eastern Algarve? Toilet cisterns, leaking taps, bathroom vanities, water heaters, and drain unblocking. Fixed upfront quotes and official invoice with NIF.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do you charge a call-out fee in Tavira?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For jobs carried out in the Tavira municipality, travel is included in the fixed quote agreed before work starts. If you request an on-site diagnostic visit only and decide not to proceed with the work, a €25 call-out fee applies.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you issue an official invoice with NIF?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, every job includes an official invoice (fatura-recibo) reported to the Portuguese Tax Authority with your NIF, giving you a written workmanship warranty and IRS tax-deduction eligibility.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I write to you in English?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, you are very welcome to write in English or Portuguese. Our spoken English is simple and practical, so sending a photo or written message on WhatsApp helps us understand everything clearly before we arrive.',
      },
    },
    {
      '@type': 'Question',
      name: 'How quickly can you schedule a visit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For standard repairs and installations, we usually book an exact time slot on the same day or the next working day.',
      },
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} schema={faqSchema}>
  <Header />

  <main class="flex-grow">
    <!-- HERO SECTION -->
    <section class="relative overflow-hidden bg-gradient-to-b from-sky-50/70 via-blue-50/30 to-white pt-14 pb-24 md:pt-24 md:pb-32">
      <!-- Subtle Ambient Water Glow Orbs -->
      <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 rounded-full bg-sky-200/35 blur-3xl"></div>
      <div class="pointer-events-none absolute top-1/2 -left-24 w-80 h-80 rounded-full bg-blue-200/25 blur-3xl"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
        <div class="max-w-3xl">
          <!-- Local Badge with Water Ripple Pulse -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/90 backdrop-blur-xs text-blue-800 text-xs sm:text-sm font-semibold mb-7 border border-blue-200/80 shadow-2xs">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-blue-600"></span>
            </span>
            Tavira & Eastern Algarve — from Faro to Vila Real de Santo António
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-5xl lg:text-[3.4rem] font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-6">
            Plumber in Tavira: <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-blue-600 via-blue-700 to-sky-500 bg-clip-text text-transparent">Fast Repairs</span>, Transparent Prices & Punctuality.
          </h1>

          <!-- Subtitle -->
          <p class="text-lg sm:text-xl text-slate-600 mb-9 leading-relaxed max-w-2xl">
            Running toilet cistern, dripping tap, toilet replacement, or water heater issue?
            <strong class="text-slate-800 font-semibold">Karpov</strong> handles home plumbing repairs and installations with a fixed upfront quote, clean work, and an official invoice with NIF.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-12">
            <a
              href="https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20a%20plumber%20in%20Tavira"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-base shadow-lg shadow-emerald-600/20 hover:shadow-xl hover:shadow-emerald-600/25 hover:-translate-y-0.5 transition-all duration-200 active:scale-[0.98]"
            >
              Request Quote via WhatsApp
            </a>

            <a
              href="#services"
              class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white hover:bg-blue-50/40 text-slate-800 hover:text-blue-700 font-bold text-base border border-slate-300 hover:border-blue-300 shadow-xs hover:-translate-y-0.5 transition-all duration-200"
            >
              View Services & Prices ↓
            </a>
          </div>

          <!-- Trust Checkmarks (Glass Pills) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs sm:text-sm font-semibold text-slate-700">
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>Fixed Upfront Price</span>
            </div>
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>On-Time Arrival</span>
            </div>
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>Invoice with NIF</span>
            </div>
            <div class="flex items-center gap-2.5 bg-white/80 backdrop-blur-xs border border-slate-200/80 rounded-xl px-3.5 py-2.5 shadow-2xs">
              <div class="w-5 h-5 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                <Check className="w-3.5 h-3.5 stroke-[2.8]" />
              </div>
              <span>Write in EN or PT</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Subtle Water Wave Divider -->
      <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none pointer-events-none">
        <svg class="relative block w-full h-8 sm:h-12 text-white" viewBox="0 0 1440 72" fill="none" preserveAspectRatio="none">
          <path d="M0,32 C320,76 640,-8 960,32 C1200,62 1360,24 1440,12 L1440,72 L0,72 Z" fill="rgba(224, 242, 254, 0.5)" />
          <path d="M0,48 C360,8 720,72 1080,32 C1260,12 1380,28 1440,40 L1440,72 L0,72 Z" fill="currentColor" />
        </svg>
      </div>
    </section>

    <!-- SERVICES & TRANSPARENT PRICING (CLICK-TO-WHATSAPP) -->
    <section id="services" class="py-20 md:py-26 bg-white border-b border-slate-200/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="inline-flex items-center gap-1.5 text-blue-600 font-bold text-xs uppercase tracking-widest bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
            Clear Services & Pricing
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-3">What do you need fixed at home today?</h2>
          <p class="text-slate-600 mt-3.5 text-sm sm:text-base leading-relaxed">
            Transparent reference prices with no hidden fees. Click the service you need to open WhatsApp directly for a quote and availability:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card 1: Toilet Cistern -->
          <a
            href="https://wa.me/351912224291?text=Hello%20Karpov,%20my%20toilet%20cistern%20is%20running/broken%20in%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 4V2.5h4V4" />
                    <rect x="4.5" y="4" width="15" height="3" rx="1" />
                    <path d="M6 7v9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7" />
                    <path d="M9 12.5c1-.8 2-.8 3 0s2 .8 3 0" />
                    <path d="M12 18v3.5" />
                  </svg>
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~45–60 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Toilet Cistern Repair</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Water constantly running into the bowl, faulty fill valve, broken flush button, or cistern not filling properly.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Labour</span>
                <span class="font-display font-extrabold text-base text-blue-600">From €45</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Ask on WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 2: Kitchen / Basin Tap -->
          <a
            href="https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20a%20tap%20repaired%20or%20replaced%20in%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Droplets className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~45 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Dripping or New Tap</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Kitchen sink, bathroom basin, or bidet tap replacement, ceramic cartridge swap, and new braided flexi hoses.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Labour</span>
                <span class="font-display font-extrabold text-base text-blue-600">From €40</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Ask on WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 3: Shower / Bath Mixer -->
          <a
            href="https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20to%20replace%20a%20shower/bath%20mixer%20in%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <ShowerHead className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~45–60 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Shower / Bath Mixer</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Replacement of standard or thermostatic shower mixers, shower columns, riser rails, hoses, and shower heads.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Labour</span>
                <span class="font-display font-extrabold text-base text-blue-600">From €45</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Ask on WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 4: Full Toilet Replacement -->
          <a
            href="https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20to%20replace/install%20a%20toilet%20in%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Toilet className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~1h30</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Full Toilet Replacement</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Removal of old toilet, installation of new pan, cistern and seat, waste connection, and neat silicone sealing.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Labour</span>
                <span class="font-display font-extrabold text-base text-blue-600">From €75</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Ask on WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 5: Bathroom Vanity Unit -->
          <a
            href="https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20a%20bathroom%20vanity%20and%20basin%20installed%20in%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Columns2 className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~1h30 – 2h</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Bathroom Vanity & Basin</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Assembly and wall-mounting of vanity unit, basin fitting, tap, pop-up waste, and trap connection.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Labour</span>
                <span class="font-display font-extrabold text-base text-blue-600">From €75</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Ask on WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 6: Bathroom Mirror / Cabinet -->
          <a
            href="https://wa.me/351912224291?text=Hello%20Karpov,%20I%20need%20a%20bathroom%20mirror%20or%20cabinet%20mounted%20in%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
                  <Lightbulb className="w-5 h-5 stroke-[1.8]" />
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-full border border-slate-200/90 shadow-2xs">~30–45 min</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">Bathroom Mirror or Cabinet</h3>
              <p class="text-slate-600 text-sm mt-2.5 leading-relaxed">
                Clean tile drilling without cracking, level mounting of standard mirrors, wall cabinets, or LED mirrors.
              </p>
            </div>
            <div class="relative z-10 mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between">
              <div>
                <span class="text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold block">Labour</span>
                <span class="font-display font-extrabold text-base text-blue-600">From €35</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/90 px-3 py-1.5 rounded-lg group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-600 transition-all duration-200">
                Ask on WhatsApp →
              </span>
            </div>
          </a>

          <!-- Card 7: Water Heater -->
          <a
            href="https://wa.me/351912224291?text=Hello%20Karpov,%20my%20water%20heater%20is%20not%20heating/leaking%20in%20Tavira"
            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
