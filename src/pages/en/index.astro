            target="_blank"
            rel="noopener noreferrer"
            class="water-card group p-6 sm:p-7 rounded-2xl bg-slate-50/75 hover:bg-white border border-slate-200/90 hover:border-blue-300 flex flex-col justify-between"
          >
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-5">
                <div class="water-icon w-12 h-12 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white group-hover:border-blue-600">
