---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = [
  {
    href: '/blog/preco-canalizador-tavira/',
    tag: 'Preços e orçamentos',
    title: 'Quanto custa um canalizador em Tavira? Preços de referência 2026',
    excerpt:
      'Preço por hora, deslocação, urgências, IVA a 6% e uma tabela com as reparações mais comuns.',
    date: '16 de novembro de 2026',
  },
];
---

<Layout
  title="Blog | Guias de Canalização em Tavira e no Algarve | Karpov"
  description="Guias práticos de canalização: preços, avarias comuns e dicas para a sua casa no Algarve."
>
  <Header />

  <main class="flex-grow">
    <section class="bg-gradient-to-b from-sky-50/70 via-blue-50/30 to-white py-14 md:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 leading-tight">Blog Karpov</h1>
        <p class="text-slate-600 mt-4 text-base sm:text-lg leading-relaxed">
          Guias práticos sobre preços, avarias comuns e manutenção da canalização, com foco em Tavira e no Algarve.
        </p>

        <div class="mt-10 space-y-4">
          {posts.map((p) => (
            <a href={p.href} class="block rounded-2xl bg-white border border-slate-200 hover:border-blue-300 hover:shadow-md transition p-6">
              <span class="text-blue-600 font-bold text-xs uppercase tracking-widest">{p.tag}</span>
              <h2 class="text-xl font-bold text-slate-900 mt-2">{p.title}</h2>
              <p class="text-slate-600 mt-2">{p.excerpt}</p>
              <p class="text-sm text-slate-500 mt-3">{p.date}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
